configuration {
    display-drun: " Applications:";
    diplay-window: "Windows:";
    drun-display-format: "{icon} {name}";
    font: "CommitMonoNerdFont Medium 11";
    modi: "window,run,drun";
    show-icons: true;
    icon-theme: "Kora";
}

@theme "/dev/null"

* {
    bg: #222222;
    bg-alt: #161616;

    fg: #EAE7E5;
    fg-alt: #FFFFFF;

    background-color: @bg;

    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 20%;
}

element {
    padding: 6;
    text-color: @fg;
}

element selected {
    text-color: @fg-alt;
    background-color: @bg-alt;
}

element-text {
    background-color: inherit;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 40;
}

entry {
    background-color: @bg;
    padding: 12;
    text-color: @fg;
}

prompt {
    text-color: @fg;
    padding: 12px;
    margin: 0px;
}

inputbar {
    children: [prompt, entry];
}

listview {
    background-color: @bg-alt;
    columns: 2;
    lines: 5;
}
